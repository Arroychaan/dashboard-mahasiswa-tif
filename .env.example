# ==============================================================================
# Dashboard Monitoring Laboratorium Informatika UNISSULA
# Environment Configuration Template (.env.example)
#
# Copy this file to `.env` for local development or production deployment.
# NEVER commit `.env` or real secrets to version control.
# ==============================================================================

# Auth.js / NextAuth secret (minimum 32 characters in production)
# Generate via: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-char-random-secret-key"

# Set to "true" when running behind a reverse proxy (Nginx / Caddy / Traefik)
AUTH_TRUST_HOST="true"

# PostgreSQL connection string (matches development docker-compose.yml defaults)
# In production, use a least-privilege application database user.
DATABASE_URL="postgresql://postgres:postgres_dev_password@localhost:5432/dashboard_mahasiswa"

# PostgreSQL container parameters (used by docker-compose.yml & docker-compose.prod.yml)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_dev_password"
POSTGRES_DB="dashboard_mahasiswa"
POSTGRES_PORT="5432"

# Production application bind address and port (used by docker-compose.prod.yml)
# Use 127.0.0.1 when behind a local reverse proxy, or 0.0.0.0 on an isolated LAN server.
APP_BIND_ADDRESS="127.0.0.1"
APP_PORT="3000"


# Production application bind address and port (used by docker-compose.prod.yml)
# Use 127.0.0.1 when behind a local reverse proxy, or 0.0.0.0 on an isolated LAN server.
APP_BIND_ADDRESS="127.0.0.1"
APP_PORT="3000"